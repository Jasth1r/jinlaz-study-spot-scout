# Copy this file to .env and fill in the password from Canvas.
# .env is listed in .gitignore, so your password never goes to GitHub.
DB_SERVER=is-info430.ischool.uw.edu
DB_PORT=1433
DB_USER=info430public
DB_PASSWORD=
# Leave this as olist for now. In step 3, after `node db/load.js` creates your
# database, change it to <your NetID>_myapp (e.g. jdoe_myapp).
# Menu A (class data) students keep olist, stackexchange, or gtfs.
DB_NAME=olist
PORT=3000
